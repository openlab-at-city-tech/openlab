{
    "name": "publishpress/publishpress-blocks",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "description": "",
    "homepage": "https://publishpress.com/",
    "authors": [
        {
            "name": "PublishPress",
            "email": "help@publishpress.com"
        }
    ],
    "config": {
        "process-timeout": 0,
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "publishpress/dev-workspace": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.2.5"
    },
    "require-dev": {
        "publishpress/dev-workspace": "^1.0"
    },
    "scripts": {
        "build:js": [
            "webpack --mode development",
            "@minify:js"
        ],
        "build:js-dev": "webpack --mode development --watch",
        "build:css": "sass assets/scss/:assets/css/ --style=compressed --no-source-map",
        "build:css-dev": "sass assets/scss/:assets/css/ -w",
        "minify:js-main": "uglifyjs assets/js/main.js --output assets/js/main.min.js",
        "minify:js-settings": "uglifyjs assets/js/settings.js --output assets/js/settings.min.js",
        "minify:js-blocks": "uglifyjs assets/blocks/blocks.js --compress --mangle --comments '/^!|@preserve|@license|@cc_on/' --output assets/blocks/blocks.min.js",
        "minify:js-frontend": "uglifyjs assets/blocks/frontend.js --compress --mangle --comments '/^!|@preserve|@license|@cc_on/' --output assets/blocks/frontend.min.js",
        "minify:js-codemirror": "uglifyjs assets/js/codemirror/lib/codemirror.js --compress --mangle --comments all --output assets/js/codemirror/lib/codemirror.min.js",
        "minify:js": [
            "@minify:js-main",
            "@minify:js-settings",
            "@minify:js-blocks",
            "@minify:js-frontend",
            "@minify:js-codemirror"
        ]
    },
    "extra": {
        "plugin-name": "publishpress-blocks",
        "plugin-slug": "advanced-gutenberg",
        "plugin-folder": "advanced-gutenberg",
        "version-constant": "ADVANCED_GUTENBERG_VERSION",
        "plugin-lang-domain": "advanced-gutenberg",
        "plugin-github-repo": "publishpress/publishpress-blocks",
        "plugin-composer-package": "publishpress/publishpress-blocks"
    }
}
